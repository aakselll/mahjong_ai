+++ b/diag_grp_prefix.py
@@ -0,0 +1,66 @@
+"""Diagnostic GRP : Phi(x^1..x^k) est-il un bon predicteur du reward final
+A CHAQUE manche k (ce que voit le RL via Phi_k - Phi_{k-1}) ?
+
+Compare le R2 de Phi_k a une baseline triviale (reward moyen selon le rang
+courant a la manche k). Si Phi_k est PIRE que la baseline aux manches 1-3,
+le reward RL est du bruit.
+
+Usage :
+  python diag_grp_prefix.py --cache grp_dataset_cache.npy \
+      --ckpt checkpoints/grp_tonpusen.pt
+"""
+import argparse
+import numpy as np
+import torch
+from mahjong_ai.agents.reward_predictor import RewardPredictor, FEATURE_DIM
+
+RANK_FEAT = 5          # index de rank/4 dans les features
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--cache', required=True)
+    ap.add_argument('--ckpt', required=True)
+    ap.add_argument('--max-seqs', type=int, default=20000)
+    ap.add_argument('--kmax', type=int, default=5)
+    a = ap.parse_args()
+
+    samples = np.load(a.cache, allow_pickle=True).item()['samples']
+    samples = samples[-a.max_seqs:]          # fin du cache = plus "valide"
+    ck = torch.load(a.ckpt, map_location='cpu', weights_only=False)
+    model = RewardPredictor(input_dim=ck.get('feature_dim', FEATURE_DIM),
+                            hidden_dim=ck.get('hidden_dim', 64), num_layers=2)
+    model.load_state_dict(ck.get('model_state_dict', ck))
+    model.eval()
+
+    phi = {k: [] for k in range(a.kmax)}
+    rnk = {k: [] for k in range(a.kmax)}
+    tgt = {k: [] for k in range(a.kmax)}
+    with torch.no_grad():
+        for seq, rew in samples:
+            seq = np.asarray(seq, dtype=np.float32)
+            # SANS padding : exactement ce que voit le RL (predict_step)
+            out = model(torch.as_tensor(seq).unsqueeze(0))[0].numpy()
+            for k in range(min(a.kmax, len(seq))):
+                phi[k].append(out[k])
+                rnk[k].append(int(round(seq[k, RANK_FEAT] * 4)))
+                tgt[k].append(rew)
+
+    print(f"{len(samples)} sequences ; R2 = 1 - MSE/Var(reward final)")
+    print(f"{'manche k':>9} {'n':>7} {'R2 Phi':>8} {'R2 base(rang)':>14}")
+    for k in range(a.kmax):
+        if not tgt[k]:
+            continue
+        y = np.array(tgt[k]); p = np.array(phi[k]); r = np.array(rnk[k])
+        var = y.var()
+        r2_phi = 1 - ((p - y) ** 2).mean() / var
+        base = np.zeros_like(y)
+        for v in np.unique(r):
+            base[r == v] = y[r == v].mean()
+        r2_base = 1 - ((base - y) ** 2).mean() / var
+        flag = "  <-- PIRE que la baseline" if r2_phi < r2_base - 0.02 else ""
+        print(f"{k+1:>9} {len(y):>7} {r2_phi:>8.3f} {r2_base:>14.3f}{flag}")
+
+
+if __name__ == '__main__':
+    main()
